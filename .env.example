APP_NAME="Kouhfar Dental Clinic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

BOOKING_PHONE_VERIFICATION_REQUIRED=true
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_DAILY_DAYS=30

# PostgreSQL is the supported local development database.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kouhfar
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

STAFF_LOGIN_THROTTLE_ATTEMPTS=5
STAFF_LOGIN_THROTTLE_SECONDS=60
STAFF_IDLE_TIMEOUT_MINUTES=15
STAFF_ABSOLUTE_TIMEOUT_MINUTES=480
STAFF_MFA_REQUIRED=true
STAFF_MFA_PENDING_TIMEOUT_MINUTES=10

AUDIT_LOG_BACKUP_PATH=
AUDIT_LOG_BACKUP_ENCRYPTION_KEY=
AUDIT_LOG_BACKUP_RETENTION_DAYS=90

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Kouhfar Dental Clinic"

# Real MeliPayamak OTP is the local test driver.
# The token is the only provider secret that must be supplied manually.
SMS_OTP_DRIVER=melipayamak
OTP_LIVE_SMS_APPROVED=true
OTP_PROVIDER_URL_PATH_RISK_ACCEPTED=true
MELIPAYAMAK_OTP_TOKEN=

AI_ENABLED=false
AI_TEXT_ENABLED=false
AI_TEXT_PROVIDER=fake
AI_TEXT_API_KEY=
AI_TEXT_MODEL=fake-v1
AI_PROVIDER_VERSION=fake-contract-v1
AI_TEXT_MODEL_VERSION=fake-v1
AI_TEXT_TIMEOUT_SECONDS=10
AI_TEXT_FALLBACK=

AI_IMAGE_ANALYSIS_ENABLED=false
AI_IMAGE_ANALYSIS_PROVIDER=fake
AI_IMAGE_ANALYSIS_API_KEY=
AI_IMAGE_ANALYSIS_MODEL=fake-v1
AI_IMAGE_ANALYSIS_TIMEOUT_SECONDS=15

AI_IMAGE_TRANSFORMATION_ENABLED=false
AI_IMAGE_TRANSFORMATION_PROVIDER=fake
AI_IMAGE_TRANSFORMATION_API_KEY=
AI_IMAGE_TRANSFORMATION_MODEL=fake-v1
AI_IMAGE_TRANSFORMATION_TIMEOUT_SECONDS=30

AI_RATE_LIMIT_PER_MINUTE=10
AI_DAILY_COST_LIMIT=0
AI_INPUT_COST_PER_1K=0
AI_OUTPUT_COST_PER_1K=0
AI_MODEL_PRICING_IRR={}
SMART_SMILE_ENABLED=false
SMART_SMILE_RELEASE_GATE=false
