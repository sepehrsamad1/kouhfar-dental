APP_NAME="Kouhfar Dental Clinic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

# Owner-confirmed: public bookings require SMS/mobile verification. Keep enabled until Task 15 provider setup.
BOOKING_PHONE_VERIFICATION_REQUIRED=true
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_LEVEL=debug
# Local daily application logs retained for 30 days.
LOG_DAILY_DAYS=30

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kouhfar
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

STAFF_LOGIN_THROTTLE_ATTEMPTS=5
STAFF_LOGIN_THROTTLE_SECONDS=60
# Owner-approved staff session policy: 15 minutes idle, 8 hours absolute.
STAFF_IDLE_TIMEOUT_MINUTES=15
STAFF_ABSOLUTE_TIMEOUT_MINUTES=480
STAFF_MFA_REQUIRED=true
STAFF_MFA_PENDING_TIMEOUT_MINUTES=10

# Audit-log backups: use a physically separate mounted volume and provision a secret key.
AUDIT_LOG_BACKUP_PATH=
AUDIT_LOG_BACKUP_ENCRYPTION_KEY=
AUDIT_LOG_BACKUP_RETENTION_DAYS=90

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Kouhfar Dental Clinic"


AI_ENABLED=false
AI_TEXT_ENABLED=false
AI_TEXT_PROVIDER=fake
AI_TEXT_API_KEY=
AI_TEXT_MODEL=fake-v1
AI_PROVIDER_VERSION=fake-contract-v1
AI_TEXT_MODEL_VERSION=fake-v1
AI_TEXT_TIMEOUT_SECONDS=10
AI_TEXT_FALLBACK=

AI_IMAGE_ANALYSIS_ENABLED=false
AI_IMAGE_ANALYSIS_PROVIDER=fake
AI_IMAGE_ANALYSIS_API_KEY=
AI_IMAGE_ANALYSIS_MODEL=fake-v1
AI_IMAGE_ANALYSIS_TIMEOUT_SECONDS=15

AI_IMAGE_TRANSFORMATION_ENABLED=false
AI_IMAGE_TRANSFORMATION_PROVIDER=fake
AI_IMAGE_TRANSFORMATION_API_KEY=
AI_IMAGE_TRANSFORMATION_MODEL=fake-v1
AI_IMAGE_TRANSFORMATION_TIMEOUT_SECONDS=30

# Live OTP SMS is disabled by default (also in CI).
# Controlled local/staging activation requires BOTH explicit approval flags below.
SMS_OTP_DRIVER=demo
UNIVERSITY_DEMO_MODE=true
OTP_DEMO_CODE=123456
UNIVERSITY_DEMO_STAFF_PASSWORD=Demo1234!
OTP_LIVE_SMS_APPROVED=false
OTP_PROVIDER_URL_PATH_RISK_ACCEPTED=false
# MeliPayamak token segment; never put a real value in this tracked example file.
MELIPAYAMAK_OTP_TOKEN=

AI_RATE_LIMIT_PER_MINUTE=10
AI_DAILY_COST_LIMIT=0
AI_INPUT_COST_PER_1K=0
AI_OUTPUT_COST_PER_1K=0
AI_MODEL_PRICING_IRR={}

# Smart Smile release gate (disabled until Task 27)
SMART_SMILE_ENABLED=false
SMART_SMILE_RELEASE_GATE=false
