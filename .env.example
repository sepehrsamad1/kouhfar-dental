APP_NAME="Kouhfar Dental Clinic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# PostgreSQL is the authoritative target for later backend tasks:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=kouhfar
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

STAFF_LOGIN_THROTTLE_ATTEMPTS=5
STAFF_LOGIN_THROTTLE_SECONDS=60
# Owner to confirm session timeout policy:
# STAFF_IDLE_TIMEOUT_MINUTES=
# STAFF_ABSOLUTE_TIMEOUT_MINUTES=

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Kouhfar Dental Clinic"
