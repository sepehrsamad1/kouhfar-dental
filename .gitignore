db-dumps/
*.sql.gz
*.dump
backups/
uploads/
private-media/
patient-images/
*.heic
*.jpg
*.jpeg
*.png
*.webp
!docs/**/*.png
!tests/fixtures/synthetic/**

# editor and OS
.DS_Store
.vscode/
.idea/

vendor/

# Laravel generated/local files
bootstrap/cache/*.php
database/*.sqlite


# Test and analysis generated files
storage/framework/phpstan/
test-results/
playwright-report/
